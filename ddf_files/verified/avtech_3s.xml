<APC_DDF
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="http://localhost/ddf_schema/apc_ddf_1_6.xsd"
  ddfid="avtech_3s"
  ddfname="AVTech 3S"
  ddfversion="1"
  canremove="yes">
	<schemaVersion>1.6</schemaVersion>

  <!--
  DEV NOTE: This DDF should not be updated to include any "external" sensors/accessories. I believe this is exclusive
  to the "digital" OID table (.1.3.6.1.4.1.20916.1.13.1.2.1.x). When sensors/accessories are connected, the device reports
  OIDs that were previously not present. When this OID/sensor is added to the DDF, DCE will still try to poll the OID on
  devices that DO NOT have this sensor/accessory. The issue is that the device will respond with a timeout instead of
  "No Such Instance", or a similar response that indicates the OID is not present. DCE will detect the timeout as a
  communication issue and mark the device as offline. The only workaround I could think of was to add a <rowTest> and
  a <valueMap> which acts as an IP address whitelist. Below is an example for a "Spot Cooler":

  <valueMap ruleid="spotCoolerWhitelist-vm">
	  <valueIn>xxx.xxx.xxx.xxx</valueIn><valueOut>[true]</valueOut> <<<< Add IP addresses of devices equipped with a specific sensor/accessory
	  <valueIn>*</valueIn><valueOut>[false]</valueOut>
  </valueMap>

  <numSensor ruleid="spot_cooler_temp">
	  <rowTest>
		  <mapValue mapid="spotCoolerWhitelist-vm"><sysHostname/></mapValue> <<<< Use <sysHostname/> to return the device's IP address for validation against defined whitelist
	  </rowTest>
	  <type>temp</type>
	  <sensorId>SPOT_COOLER_TEMP</sensorId>
	  <value>
		  <mult>
		  <op><getOid>.1.3.6.1.4.1.20916.1.13.1.2.1.1.0</getOid></op>
		  <op>0.01</op>
		  </mult>
	  </value>
	  <valueInc>0.01</valueInc>
	  <label><getOid>.1.3.6.1.4.1.20916.1.13.1.4.2.1.0</getOid> Temperature</label>
	  <sensorSet>Temperature Sensors</sensorSet>
  </numSensor>

  Until AVTech addresses this timeout response issue for OIDs that are not present, this DDF should be left in its current
  state only including the "default" sensors and nothing more. If a customer needs sensor/accessory OIDs to be added,
  the DDF must be customized to add sensors/OIDs and the IP whitelist workaround described above.

  Note that if ALL 3S devices being monitored in DCE ALL have the same sensor(s)/accessory(ies), then the IP whitelist is not needed.
  However, even if there is 1 device that does not have the sensor/accessory, the whitelist is needed to avoid the timeout issue.
  -->

  <device deviceid="avtech_3s">
		<suppressRule ruleid="suppresscorevendordata" suppressid="core/mib2data/vendordata"/>
		<suppressRule ruleid="suppresscoremodeldata" suppressid="core/mib2data/modeldata"/>
		<suppressRule ruleid="suppresscoretypedata" suppressid="core/mib2data/typedata"/>

		<setProductData ruleid="vendordata" field="vendor">AVTech</setProductData>
		<setProductData ruleid="modeldata" field="model">RoomAlert 3S</setProductData>
		<setProductData ruleid="typedata" field="type">Environmental Monitor</setProductData>

		<oidMustExist ruleid="avtech_3s_exists" oid=".1.3.6.1.4.1.20916.1.13" istree="yes" /> 

		<numSensor ruleid="internal-tempc">
			<type>temp</type>
			<sensorId>INTERNAL_TEMP</sensorId>
			<value>
				<mult>
				<op><getOid>.1.3.6.1.4.1.20916.1.13.1.1.1.2.0</getOid></op>
				<op>0.01</op>
				</mult>
			</value>
			<valueInc>0.01</valueInc>
			<label><getOid>.1.3.6.1.4.1.20916.1.13.1.4.1.1.0</getOid> Temperature</label>
			<sensorSet>Temperature Sensors</sensorSet>
		</numSensor>
		<stateSensor ruleid="switch-sen1">
			<type>state</type>
			<sensorId>SWITCH_SENSOR_1</sensorId>
			<value>
				<mapValue mapid="openClosed-vm">
					<getOid>.1.3.6.1.4.1.20916.1.13.1.3.1.0</getOid>
				</mapValue>
			</value>
			<label><getOid>.1.3.6.1.4.1.20916.1.13.1.4.3.1.0</getOid></label>
			<enum>openClosed-em</enum>
			<sensorSet>Temperature Sensors</sensorSet>
		</stateSensor>

		<valueMap ruleid="openClosed-vm">
			<valueIn>0</valueIn><valueOut>0</valueOut>
			<valueIn>1</valueIn><valueOut>1</valueOut>
			<valueIn>*</valueIn><valueOut>2</valueOut>
		</valueMap>

		<enumMap ruleid="openClosed-em">
			<label>Open</label>
			<label>Closed</label>
			<label>Unknown</label>
		</enumMap>
	</device>
</APC_DDF>