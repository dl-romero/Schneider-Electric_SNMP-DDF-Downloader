<?xml version="1.0" encoding="UTF-8"?>
<APC_DDF
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="http://localhost/ddf_schema/apc_ddf_1_6.xsd"
	ddfid="nti_enviromux_microt"
	ddfname="NTI ENVIROMUX E-MICRO-T"
	ddfversion="4"
	canremove="yes">
	<schemaVersion>1.6</schemaVersion>
	<device deviceid="NTINetworkTechnologiesINC_ENVIROMUXMICROT">
		<!--
			The E-W1 and E-MICRO-T return the same OIDs. E-MICRO-T has sensors for intSensors OID table (.1.3.6.1.4.1.3699.1.1.12.1.1.x).
			oidMustNotMatch checks for a valid temerature reading.
		-->
		<oidMustExist ruleid="snmpdevicetest" oid=".1.3.6.1.4.1.3699.1.1.12.1" istree="yes"/>
		<oidMustNotMatch ruleid="microTTempCheck" oid=".1.3.6.1.4.1.3699.1.1.12.1.1.1.1.4.1"><valueList><value>0</value></valueList></oidMustNotMatch>

		<setProductData ruleid="vendordata" field="vendor">NTI</setProductData>
		<setProductData ruleid="modeldata" field="model">E-MICRO-T</setProductData>
		<setProductData ruleid="typedata" field="type">Environmental Monitor</setProductData>

        <valueMap ruleid="map_units">
            <valueIn>1</valueIn><valueOut>temp</valueOut>
            <valueIn>2</valueIn><valueOut>humidity</valueOut>
            <valueIn>24</valueIn><valueOut>temp</valueOut>
            <valueIn>*</valueIn><valueOut>num</valueOut>
        </valueMap>
        <valueMap ruleid="map_sensorId">
            <valueIn>1</valueIn><valueOut>TEMPERATURE</valueOut>
            <valueIn>2</valueIn><valueOut>HUMIDITY</valueOut>
            <valueIn>24</valueIn><valueOut>DEW_POINT</valueOut>
            <valueIn>*</valueIn><valueOut>NUM</valueOut>
        </valueMap>

		<numSensor ruleid="intSensorValue" index=".1.3.6.1.4.1.3699.1.1.12.1.1.1.1.1">
			<type><mapValue mapid="map_units"><getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.1.1.1.2</getRowOid></mapValue></type>
			<sensorId>_<mapValue mapid="map_sensorId"><getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.1.1.1.2</getRowOid></mapValue>_<rowIndex/></sensorId>
			<value>
				<if>
					<op>
						<eq>
							<op><getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.1.1.1.5</getRowOid></op>
							<op>1</op>
						</eq>
					</op>
					<op>
						<div>
							<op>
								<sub>
									<op>
										<mult>
											<op><getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.1.1.1.4</getRowOid></op>
											<op>0.1</op>
										</mult>
									</op>
									<op>32</op>
								</sub>
							</op>
							<op>1.8</op>
						</div>
					</op>
					<op>
						<mult>
							<op><getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.1.1.1.4</getRowOid></op>
							<op>0.1</op>
						</mult>
					</op>
				</if>
			</value>
			<label><getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.1.1.1.3</getRowOid></label>
			<sensorSet>Integrated Sensors</sensorSet>
		</numSensor>

		<stateSensor ruleid="dig_input_value" index=".1.3.6.1.4.1.3699.1.1.12.1.3.1.1.1">
			<type>state</type>
			<sensorId>DIG_INPUT_VALUE_<rowIndex/></sensorId>
			<value>
				<mapValue mapid="closeOpen-vm">
					<getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.3.1.1.3</getRowOid>
				</mapValue>
			</value>
			<label><getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.3.1.1.2</getRowOid> Status</label>
			<enum>closeOpen-em</enum>
			<sensorSet>General</sensorSet>
		</stateSensor>
		<valueMap ruleid="closeOpen-vm">
			<valueIn>0</valueIn><valueOut>0</valueOut>
			<valueIn>1</valueIn><valueOut>1</valueOut>
			<valueIn>*</valueIn><valueOut>2</valueOut>
		</valueMap>

		<enumMap ruleid="closeOpen-em">
			<label>Close</label>
			<label>Open</label>
			<label>Unknown</label>
		</enumMap>

		<valueMap ruleid="skip_null_alarm">
			<valueIn>0</valueIn><valueOut>[false]</valueOut>
			<valueIn>*</valueIn><valueOut>[true]</valueOut>
		</valueMap>

		<alarmFlags2 ruleid="alert_status_alarm" index=".1.3.6.1.4.1.3699.1.1.12.1.5.1.1.1">
			<rowTest>
				<mapValue mapid="skip_null_alarm"><getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.5.1.1.2</getRowOid></mapValue> <!-- confirm alarm is enabled -->
			</rowTest>
			<value><getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.5.1.1.7</getRowOid></value>
			<alarmFlagsTest match="1">
				<name>
					<activeText><getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.5.1.1.3</getRowOid> Entering Critical Alarm (<getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.5.1.1.8</getRowOid>)</activeText>
					<inactiveText><getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.5.1.1.3</getRowOid> Entering Critical Alarm (<getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.5.1.1.8</getRowOid>) Cleared</inactiveText>
				</name>
				<severity>warning</severity>
				<category>System</category>
				<description>
					<activeText><getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.5.1.1.3</getRowOid> Entering Critical alarm condition (<getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.5.1.1.8</getRowOid>) exists.</activeText>
					<inactiveText><getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.5.1.1.3</getRowOid> Entering Critical alarm condition (<getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.5.1.1.8</getRowOid>) no longer exists.</inactiveText>
				</description>
			</alarmFlagsTest>
			<alarmFlagsTest match="2">
				<name>
					<activeText><getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.5.1.1.3</getRowOid> Critical Alarm (<getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.5.1.1.8</getRowOid>)</activeText>
					<inactiveText><getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.5.1.1.3</getRowOid> Critical Alarm (<getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.5.1.1.8</getRowOid>) Cleared</inactiveText>
				</name>
				<severity>critical</severity>
				<category>System</category>
				<description>
					<activeText><getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.5.1.1.3</getRowOid> Critical alarm condition (<getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.5.1.1.8</getRowOid>) exists.</activeText>
					<inactiveText><getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.5.1.1.3</getRowOid> Critical alarm condition (<getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.5.1.1.8</getRowOid>) no longer exists.</inactiveText>
				</description>
			</alarmFlagsTest>
			<alarmFlagsTest match="4">
				<name>
					<activeText><getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.5.1.1.3</getRowOid> Alarm Awaiting Acknowledgment/Dismissal (<getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.5.1.1.8</getRowOid>)</activeText>
					<inactiveText><getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.5.1.1.3</getRowOid> Alarm Awaiting Acknowledgment/Dismissal (<getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.5.1.1.8</getRowOid>) Cleared</inactiveText>
				</name>
				<severity>informational</severity>
				<category>System</category>
				<description>
					<activeText><getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.5.1.1.3</getRowOid> alarm awaiting acknowledgment/dismissal (<getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.5.1.1.8</getRowOid>).</activeText>
					<inactiveText><getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.5.1.1.3</getRowOid> alarm awaiting acknowledgment/dismissal (<getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.5.1.1.8</getRowOid>) condition no longer exists.</inactiveText>
				</description>
			</alarmFlagsTest>
			<alarmFlagsTest match="7">
				<name>
					<activeText><getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.5.1.1.3</getRowOid> Disconnected Alarm (<getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.5.1.1.8</getRowOid>)</activeText>
					<inactiveText><getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.5.1.1.3</getRowOid> Disconnected Alarm (<getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.5.1.1.8</getRowOid>) Cleared</inactiveText>
				</name>
				<severity>critical</severity>
				<category>System</category>
				<description>
					<activeText><getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.5.1.1.3</getRowOid> Disconnected alarm (<getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.5.1.1.8</getRowOid>) condition exists.</activeText>
					<inactiveText><getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.5.1.1.3</getRowOid> Disconnected alarm (<getRowOid>.1.3.6.1.4.1.3699.1.1.12.1.5.1.1.8</getRowOid>) condition no longer exists.</inactiveText>
				</description>
			</alarmFlagsTest>
		</alarmFlags2>
	</device>
</APC_DDF>