		\snmp\resources\mibs\hpe\RACKCDUV4_SMI_V2-MIB.MIB
	
		RACKCDU-SMI-V2-MIB-V18 | 02 March 2022
	
	-->
	<device deviceid="hpe_rack_cdu">
