<?xml version="1.0" encoding="UTF-8"?>
<APC_DDF xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="http://localhost/ddf_schema/apc_ddf_1_6.xsd"
	ddfid="vultan_monitoring_unit"
	ddfname="Vultan Monitoring Unit"
	ddfversion="1"
	canremove="yes">
	<schemaVersion>1.6</schemaVersion>
  <!--
  SOURCE
  \snmp\mibs\vutlan\vutlan .mib

  DDF-1247 | 20 June 2023
  -->
	<device deviceid="vultan_monitoring_unit">
		<oidMustExist ruleid="snmpdevicetest" oid=".1.3.6.1.4.1.39052.1" istree="yes"/>		
		<setProductData ruleid="vendordata" field="vendor">Vultan</setProductData>
		<setProductData ruleid="modeldata" field="model"><getOid>.1.3.6.1.4.1.39052.1.7.1.0</getOid></setProductData>
    <setProductData ruleid="appversion" field="appversion"><getOid>.1.3.6.1.4.1.39052.1.7.2.0</getOid></setProductData>
		<setProductData ruleid="macaddr" field="mac_addr"><getOid>.1.3.6.1.4.1.39052.1.7.14.0</getOid></setProductData>
		<setProductData ruleid="typedata" field="type">Environmental Monitor</setProductData>
        
    <valueMap ruleid="sensorType-vm">
      <valueIn>*</valueIn><valueOut>num</valueOut>
      <valueIn>temperature</valueIn><valueOut>temp</valueOut>
      <valueIn>voltage</valueIn><valueOut>voltage</valueOut>
    </valueMap>
    <valueMap ruleid="stateSensorCheck-vm">
			<valueIn>dry</valueIn><valueOut>[true]</valueOut>
			<valueIn>water</valueIn><valueOut>[true]</valueOut>
			<valueIn>*</valueIn><valueOut>[false]</valueOut>
		</valueMap>
    <valueMap ruleid="numSensorCheck-vm">
			<valueIn>temperature</valueIn><valueOut>[true]</valueOut>
			<valueIn>voltage</valueIn><valueOut>[true]</valueOut>
			<valueIn>*</valueIn><valueOut>[false]</valueOut>
		</valueMap>
		<valueMap ruleid="sensorID-vm">
			<valueIn>dry</valueIn><valueOut>_CONTACT</valueOut>
			<valueIn>temperature</valueIn><valueOut>_TEMP</valueOut>
			<valueIn>voltage</valueIn><valueOut>_VOLTAGE</valueOut>
			<valueIn>water</valueIn><valueOut>_WATER</valueOut>
		</valueMap>
        
    <stateSensor ruleid="ctlUnitElementValue_state" index=".1.3.6.1.4.1.39052.1.3.1.9">
        <rowTest>
            <mapValue mapid="stateSensorCheck-vm">
                <getRowOid>.1.3.6.1.4.1.39052.1.3.1.6</getRowOid>
            </mapValue>
        </rowTest>
        <type>state</type>
        <sensorId><mapValue mapid="sensorID-vm"><getRowOid>.1.3.6.1.4.1.39052.1.3.1.6</getRowOid></mapValue>_STATUS_<rowIndex/></sensorId>
        <value>
            <mapValue mapid="normal_alarm-vm">
                <getRowOid>.1.3.6.1.4.1.39052.1.3.1.9</getRowOid>
            </mapValue>
        </value>
        <label><getRowOid>.1.3.6.1.4.1.39052.1.3.1.7</getRowOid> Status</label>
        <enum>normal_alarm-em</enum>
        <sensorSet>Unit Elements</sensorSet>
    </stateSensor>
        
		<enumMap ruleid="normal_alarm-em">
			<label>Normal</label>
			<label>Alarm</label>
			<label>Unknown</label>
		</enumMap>
		<valueMap ruleid="normal_alarm-vm">
			<valueIn>0</valueIn><valueOut>0</valueOut>
			<valueIn>1</valueIn><valueOut>1</valueOut>
			<valueIn>*</valueIn><valueOut>2</valueOut>
		</valueMap>
        
    <numSensor ruleid="ctlUnitElementValue_numeric" index=".1.3.6.1.4.1.39052.1.3.1.9">
        <rowTest>
            <mapValue mapid="numSensorCheck-vm">
                <getRowOid>.1.3.6.1.4.1.39052.1.3.1.6</getRowOid>
            </mapValue>
        </rowTest>
        <type>
            <mapValue mapid="sensorType-vm">
                <getRowOid>.1.3.6.1.4.1.39052.1.3.1.6</getRowOid>
            </mapValue>
        </type>
        <sensorId><mapValue mapid="sensorID-vm"><getRowOid>.1.3.6.1.4.1.39052.1.3.1.6</getRowOid></mapValue>_SENSOR_<rowIndex/></sensorId>
        <value>
            <getRowOid>.1.3.6.1.4.1.39052.1.3.1.9</getRowOid>
        </value>
        <label><getRowOid>.1.3.6.1.4.1.39052.1.3.1.7</getRowOid></label>
        <sensorSet>Unit Elements</sensorSet>
    </numSensor>
    
    </device>
</APC_DDF>