		<numSensor ruleid="upsAdvTestBatteryLastDate">
			<type>timeindays</type>
      <rowTest>
				<neqString>
					<op>
						<getOid>.1.3.6.1.4.1.318.1.1.1.7.2.13.0</getOid>
					</op>
					<op>01/01/2000</op>
				</neqString>
			</rowTest>
			<sensorId>ADV_TEST_BATTERY_LAST_DATE</sensorId>
			<value>
				<round increment="1">
					<div>
						<op>
							<sub>
								<op>
									<curUTCTime/>
								</op>
								<op>
									<parseDate>
										<if>
											<op>
												<!-- does the value use 3-char months? -->
												<regex>
													<op>([a-zA-Z]{3})</op>
													<op>
														<getOid>.1.3.6.1.4.1.318.1.1.1.7.2.13.0</getOid>
													</op>
													<op>[true]</op>
													<op>[false]</op>
												</regex>
											</op>
											<op>
												<!-- yes it does use 3-char months-->
												<if>
													<op>
														<!-- does date or month come first? -->
														<regex>
															<op>(\d\d)-([a-zA-Z]{3})-(\d\d)</op>
															<op>
																<getOid>.1.3.6.1.4.1.318.1.1.1.7.2.13.0</getOid>
															</op>
															<op>[true]</op>
															<op>[false]</op>
														</regex>
													</op>
													<op>
														<!-- date comes before month -->
														<mapValue mapid="parseMonth-vm">
															<regex>
																<op>\d\d-([a-zA-Z]{3})-\d\d</op>
																<op>
																	<getOid>.1.3.6.1.4.1.318.1.1.1.7.2.13.0</getOid>
																</op>
																<op>%1$s</op>
																<op>Nul</op>
															</regex>
														</mapValue>
														-
														<regex>
															<op>(\d\d)-[a-zA-Z]{3}-\d\d</op>
															<op>
																<getOid>.1.3.6.1.4.1.318.1.1.1.7.2.13.0</getOid>
															</op>
															<op>%1$s</op>
															<op>00</op>
														</regex>
													</op>
													<!-- DD-Mon... -->
													<op>
														<!-- month comes before date -->
														<mapValue mapid="parseMonth-vm">
															<regex>
																<op>([a-zA-Z]{3})-\d\d-\d\d</op>
																<op>
																	<getOid>.1.3.6.1.4.1.318.1.1.1.7.2.13.0</getOid>
																</op>
																<op>%1$s</op>
																<op>Nul</op>
															</regex>
														</mapValue>
														-
														<regex>
															<op>[a-zA-Z]{3}-(\d\d)-\d\d</op>
															<op>
																<getOid>.1.3.6.1.4.1.318.1.1.1.7.2.13.0</getOid>
															</op>
															<op>%1$s</op>
															<op>00</op>
														</regex>
													</op>
													<!-- Mon-DD... -->
												</if>
												-
												<!-- and year always comes last when 3-char months are used -->
												<regex>
													<op>-(\d\d)$</op>
													<op>
														<getOid>.1.3.6.1.4.1.318.1.1.1.7.2.13.0</getOid>
													</op>
													<op>%1$s</op>
													<op>00</op>
												</regex>
												<!-- ...YY -->
											</op>
											<op>
												<!-- does not use 3-char months, just need to rearrange terms -->
												<regex>
													<op>(\d\d\d\d)[-\/](\d\d)[-\/](\d\d)</op>
													<op>
														<getOid>.1.3.6.1.4.1.318.1.1.1.7.2.13.0</getOid>
													</op>
													<op>%2$s\/%3$s\/%1$s</op>
													<!-- YYYY-MM-DD -->
													<op>
														<regex>
															<op>^(\d\d)\.(\d\d)\.(\d\d\d\d)$</op>
															<op>
																<getOid>.1.3.6.1.4.1.318.1.1.1.7.2.13.0</getOid>
															</op>
															<!-- DD.MM.YYYY -->
															<op>%2$s\/%1$s\/%3$s</op>
															<op>
																<getOid>.1.3.6.1.4.1.318.1.1.1.7.2.13.0</getOid>
															</op>
															<!-- MM/DD/YYYY -->
														</regex>
													</op>
												</regex>
											</op>
										</if>
									</parseDate>
								</op>
							</sub>
						</op>
						<op>86400</op>
					</div>
				</round>
			</value>
			<minValue>0</minValue>
			<valueInc>1</valueInc>
			<label>Time Since Last Battery Test</label>
			<sensorSet>Charger Battery Status</sensorSet>
