									<parseDate>
										<if>
											<op>
												<!-- does the value use 3-char months? -->
												<regex>
													<op>([a-zA-Z]{3})</op>
													<op>
														<getOid>.1.3.6.1.4.1.318.1.1.1.2.1.3.0</getOid>
													</op>
													<op>[true]</op>
													<op>[false]</op>
												</regex>
											</op>
											<op>
												<!-- yes it does use 3-char months-->
												<if>
													<op>
														<!-- does date or month come first? -->
														<regex>
