<?xml version="1.0" encoding="UTF-8"?>
<APC_DDF
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="http://localhost/ddf_schema/apc_ddf_1_6.xsd"
  ddfid="emersonvertiv_ita1_3k_ups"
  ddfname="Emerson/Vertiv ITA1 3K UPS"
  ddfversion="1"
  canremove="yes">
	<!--
    Model:							Emerson/Vertiv ITA1 3K UPS
    Reference:						ITA1 3K UPS MIB (ENP_UPS_ITA1_3K[COM]-MIB.mib)
    Reference Location:		        /snmp/resources/mibs/emerson/ENP_UPS_ITA1_3K[COM]-MIB.mib
    Walkfiles:						/snmp/resources/sapro/walkfiles/emerson/UHA1R-0030.walk
  -->
    <schemaVersion>1.6</schemaVersion>
    <device deviceid="emersonvertiv_ita1_3k_ups">
        <oidMustExist ruleid="ita13kMustExists" oid=".1.3.6.1.4.1.13400.2.26" istree="yes"/>
        <setProductData ruleid="vendordata" field="vendor">Emerson/Vertiv</setProductData>
        <setProductData ruleid="typedata" field="type">UPS</setProductData>
        <setProductData ruleid="modeldata" field="model">ITA1 3K</setProductData>
    
        <!--Group 2-->
        <numSensor ruleid="input_voltage">
            <type>voltage</type>
            <sensorId>INPUT_VOLTAGE</sensorId>
            <value>
                <mult>
                    <op>
                        <getOid>.1.3.6.1.4.1.13400.2.26.2.2.1.0</getOid>
                    </op>
                    <op>0.01</op>
                </mult>
            </value>
            <valueInc>0.01</valueInc>
            <label>Input Voltage</label>
            <sensorSet>Group 2</sensorSet>
        </numSensor>
        <numSensor ruleid="output_voltage">
            <type>voltage</type>
            <sensorId>OUTPUT_VOLTAGE</sensorId>
            <value>
                <mult>
                    <op>
                        <getOid>.1.3.6.1.4.1.13400.2.26.2.2.3.0</getOid>
                    </op>
                    <op>0.01</op>
                </mult>
            </value>
            <valueInc>0.01</valueInc>
            <label>Output Voltage</label>
            <sensorSet>Group 2</sensorSet>
        </numSensor>
        <numSensor ruleid="output_current">
            <type>amperage</type>
            <sensorId>OUTPUT_CURRENT</sensorId>
            <value>
                <mult>
                    <op>
                        <getOid>.1.3.6.1.4.1.13400.2.26.2.2.4.0</getOid>
                    </op>
                    <op>0.01</op>
                </mult>
            </value>
            <valueInc>0.01</valueInc>
            <label>Output Current</label>
            <sensorSet>Group 2</sensorSet>
        </numSensor>
        <numSensor ruleid="output_frequency">
            <type>frequency</type>
            <sensorId>OUTPUT_FREQUENCY</sensorId>
            <value>
                <mult>
                    <op>
                        <getOid>.1.3.6.1.4.1.13400.2.26.2.2.5.0</getOid>
                    </op>
                    <op>0.01</op>
                </mult>
            </value>
            <valueInc>0.01</valueInc>
            <label>Output Frequency</label>
            <sensorSet>Group 2</sensorSet>
        </numSensor>
        <numSensor ruleid="battery_voltage">
            <type>voltage</type>
            <sensorId>BATTERY_VOLTAGE</sensorId>
            <value>
                <mult>
                    <op>
                        <getOid>.1.3.6.1.4.1.13400.2.26.2.2.11.0</getOid>
                    </op>
                    <op>0.01</op>
                </mult>
            </value>
            <valueInc>0.01</valueInc>
            <label>Battery Voltage</label>
            <sensorSet>Group 2</sensorSet>
        </numSensor>
        <numSensor ruleid="battery_remains_time">
            <type>timeinmin</type>
            <sensorId>BATTERY_REMAINS_TIME</sensorId>
            <value>
                <mult>
                    <op>
                        <getOid>.1.3.6.1.4.1.13400.2.26.2.2.12.0</getOid>
                    </op>
                    <op>0.01</op>
                </mult>
            </value>
            <valueInc>0.01</valueInc>
            <label>Battery Remains Time</label>
            <sensorSet>Group 2</sensorSet>
        </numSensor>
        <numSensor ruleid="bypass_voltage">
            <type>voltage</type>
            <sensorId>BYPASS_VOLTAGE</sensorId>
            <value>
                <mult>
                    <op>
                        <getOid>.1.3.6.1.4.1.13400.2.26.2.2.9.0</getOid>
                    </op>
                    <op>0.01</op>
                </mult>
            </value>
            <valueInc>0.01</valueInc>
            <label>Bypass Voltage</label>
            <sensorSet>Group 2</sensorSet>
        </numSensor>
        <valueMap ruleid="battChargeMode-vm">
            <valueIn>0</valueIn><valueOut>0</valueOut>
            <valueIn>1</valueIn><valueOut>1</valueOut>
            <valueIn>2</valueIn><valueOut>2</valueOut>
            <valueIn>3</valueIn><valueOut>3</valueOut>
            <valueIn>*</valueIn><valueOut>4</valueOut>
        </valueMap>
        <enumMap ruleid="battChargeMode-em">
            <label>Non Charging Non Discharge</label>
            <label>Float Charging</label>
            <label>Equalization Charging</label>
            <label>Discharging</label>
            <label>Unknown</label>
        </enumMap>
        <stateSensor ruleid="battery_charge_mode">
            <type>state</type>
            <sensorId>BATTERY_CHARGE_MODE</sensorId>
            <value>
                <mapValue mapid="battChargeMode-vm">
                    <getOid>.1.3.6.1.4.1.13400.2.26.2.2.13.0</getOid>
                </mapValue>
            </value>
            <label>Battery Charge Mode</label>
            <enum>battChargeMode-em</enum>
            <sensorSet>Group 2</sensorSet>
        </stateSensor>
        
        <!--Group 4-->
        <valueMap ruleid="upsOpMode-vm">
            <valueIn>0</valueIn><valueOut>0</valueOut>
            <valueIn>1</valueIn><valueOut>1</valueOut>
            <valueIn>2</valueIn><valueOut>2</valueOut>
            <valueIn>3</valueIn><valueOut>3</valueOut>
            <valueIn>4</valueIn><valueOut>4</valueOut>
            <valueIn>*</valueIn><valueOut>5</valueOut>
        </valueMap>
        <enumMap ruleid="upsOpMode-em">
            <label>UPS Shutdown</label>
            <label>Utility Online</label>
            <label>On Battery</label>
            <label>On Bypass</label>
            <label>UPS Union Mode</label>
            <label>Unknown</label>
        </enumMap>
        <stateSensor ruleid="ups_operating_mode">
            <type>state</type>
            <sensorId>UPS_OPERATING_MODE</sensorId>
            <value>
                <mapValue mapid="upsOpMode-vm">
                    <getOid>.1.3.6.1.4.1.13400.2.26.2.4.4.0</getOid>
                </mapValue>
            </value>
            <label>UPS Operating Mode</label>
            <enum>upsOpMode-em</enum>
            <sensorSet>Group 4</sensorSet>
        </stateSensor>
        
        <!--Alarm Trap-->
        <valueMap ruleid="alarmSeverity-vm">
			<valueIn>0</valueIn><valueOut>informational</valueOut>
			<valueIn>1</valueIn><valueOut>warning</valueOut>
			<valueIn>2</valueIn><valueOut>critical</valueOut>
		</valueMap>
        <alarmFlags2 ruleid="alarmTrapTable" index=".1.3.6.1.4.1.13400.2.26.3.1.1">
			<value><getRowOid>.1.3.6.1.4.1.13400.2.26.3.1.3</getRowOid></value>
			<alarmFlagsTest match="0">
				<name>
					<activeText><getRowOid>.1.3.6.1.4.1.13400.2.26.3.1.5</getRowOid></activeText>
					<inactiveText><getRowOid>.1.3.6.1.4.1.13400.2.26.3.1.5</getRowOid> Cleared</inactiveText>
				</name>
				<severity>
                    <mapValue mapid="alarmSeverity-vm">
                        <getRowOid>.1.3.6.1.4.1.13400.2.26.3.1.4</getRowOid>
                    </mapValue>
				</severity>
				<category>System</category>
				<description>
					<activeText><getRowOid>.1.3.6.1.4.1.13400.2.26.3.1.5</getRowOid> condition exists.</activeText>
					<inactiveText><getRowOid>.1.3.6.1.4.1.13400.2.26.3.1.5</getRowOid> condition no longer exists.</inactiveText>
				</description>
			</alarmFlagsTest>
		</alarmFlags2>
    </device>
</APC_DDF>